  Image: {fileID: 0}
  preview:
    Lang: 4
    Title: "\u062A\u062A\u0643\u0648\u0646 \u0627\u0644\u0639\u0645\u0631\u0629 \u0645\u0646
      \u062E\u0645\u0633 \u0645\u0631\u0627\u062D\u0644 \u0631\u0626\u064A\u0633\u064A\u0629:
      1) \u0627\u0644\u062F\u062E\u0648\u0644 \u0641\u064A \u062D\u0627\u0644\u0629
      \u0627\u0644\u0625\u062D\u0631\u0627\u0645 \u0639\u0646\u062F \u0627\u0644\u0645\u064A\u0642\u0627\u062A\u061B
      2) \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062C\u062F
      \u0627\u0644\u062D\u0631\u0627\u0645\u061B 3) \u0623\u062F\u0627\u0621 \u0627\u0644\u0637\u0648\u0627\u0641
      \u062D\u0648\u0644 \u0627\u0644\u0643\u0639\u0628\u0629\u061B 4) \u0623\u062F\u0627\u0621
      \u0627\u0644\u0633\u0639\u064A \u0628\u064A\u0646 \u0627\u0644\u0635\u0641\u0627
      \u0648\u0627\u0644\u0645\u0631\u0648\u0629\u061B 5) \u062D\u0644\u0642 \u0623\u0648
      \u0642\u0635 \u0627\u0644\u0634\u0639\u0631 \u0648\u0627\u0644\u062E\u0631\u0648\u062C
      \u0645\u0646 \u0627\u0644\u0625\u062D\u0631\u0627\u0645."
    Description: "\u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629
      \u0644\u0644\u0639\u0645\u0631\u0629"
